<% layout("/layouts/boilerplate") -%>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <!-- Card for Listing -->
      <div class="card shadow-lg">
        <% 
          // ✅ Safe image handling
          var imgUrl = (listing.image && typeof listing.image === 'object' && listing.image.url) 
            ? listing.image.url 
            : listing.image || 'https://plus.unsplash.com/premium_photo-1683910767532-3a25b821f7ae?q=80&w=808&auto=format&fit=crop';
        %>
        <img 
          src="<%= imgUrl %>" 
          class="card-img-top" 
          alt="listing image"
          style="height: 25rem; object-fit: cover;"
        />

        <div class="card-body">
          <h3 class="card-title"><%= listing.title %></h3>
          <p class="card-text text-muted"><%= listing.description %></p>
          
          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item">
              <b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
            </li>
            <li class="list-group-item">
              <b>Location:</b> <%= listing.location %>
            </li>
            <li class="list-group-item">
              <b>Country:</b> <%= listing.country %>
            </li>
          </ul>

          <!-- Action Buttons -->
          <div class="d-flex justify-content-between">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Edit</a>
            
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <button class="btn btn-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
