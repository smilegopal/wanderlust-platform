<% layout("/layouts/boilerplate") %>

<script>
  mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h3><%= listing.title %></h3>

      <div class="card shadow-lg listing-card">
        <img 
          src="<%= listing.image.url %>"
          class="card-img-top"
          style="height: 25rem; object-fit: cover;"
        />

        <div class="card-body">

          <!-- Owner Name -->
          <p class="text-muted">
            Owned by:
            <% if (listing.owner && listing.owner.username) { %>
              <i><%= listing.owner.username %></i>
            <% } else { %>
              <i>Unknown</i>
            <% } %>
          </p>

          <p class="text-muted"><%= listing.description %></p>

          <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item"><b>Price:</b> ₹<%= listing.price %> / night</li>
            <li class="list-group-item"><b>Location:</b> <%= listing.location %></li>
            <li class="list-group-item"><b>Country:</b> <%= listing.country %></li>
          </ul>


      <!-- ✅ Show guest list only to listing owner -->
<% if (currUser && listing.owner && String(listing.owner._id) === String(currUser._id)) { %>
  <hr>
  <h4>Your Guests</h4>

  <% if (bookingData.length > 0) { %>
    <% bookingData.forEach(b => { %>
      <div class="border p-2 mb-2 rounded">
        <p><b>Name:</b> <%= b.user?.username ?? "Unknown" %></p>
        <p><b>Email:</b> <%= b.user?.email ?? "N/A" %></p>
        <p><b>Booked On:</b> <%= b.bookedAt ? b.bookedAt.toLocaleString() : "N/A" %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>No bookings yet.</p>
  <% } %>
<% } %>


          <!-- ✅ Edit/Delete only for owner -->
          <% if (currUser && listing.owner && String(listing.owner._id) === String(currUser._id)) { %>
            <div class="d-flex justify-content-between">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Edit</a>
              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger">Delete</button>
              </form>
            </div>
          <% } %>


          <!-- ✅ Show Book button for non-owner -->
<% if (!currUser || !listing.owner || String(listing.owner._id) !== String(currUser._id)) { %>
  <form action="/listings/<%= listing._id %>/book" method="POST">
    <button class="btn btn-success w-100 mt-3">Book Now</button>
  </form>
<% } %>


<!-- Reviews Section -->
<div class="col-10 offset-1 mb-3">
  <% if (currUser && listing.owner && String(listing.owner._id) !== String(currUser._id)) { %>
    <hr>
    <h4 class="mb-3">Leave a Review</h4>

    <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
      <!-- Star Rating -->
      <div class="mb-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-basic">
          <input type="radio" id="rate5" name="review[rating]" value="5" />
          <label for="rate5" title="Amazing">5 stars</label>

          <input type="radio" id="rate4" name="review[rating]" value="4" />
          <label for="rate4" title="Very good">4 stars</label>

          <input type="radio" id="rate3" name="review[rating]" value="3" />
          <label for="rate3" title="Average">3 stars</label>

          <input type="radio" id="rate2" name="review[rating]" value="2" />
          <label for="rate2" title="Not good">2 stars</label>

          <input type="radio" id="rate1" name="review[rating]" value="1" />
          <label for="rate1" title="Terrible">1 star</label>
        </fieldset>
      </div>

      <!-- Comment Box -->
      <div class="mb-3">
        <label class="form-label">Comments</label>
        <textarea class="form-control" name="review[comment]" rows="3" placeholder="Share your experience..." required></textarea>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr>
  <% } %>

  <!-- Show existing reviews -->
  <% if (listing.reviews.length > 0) { %>
    <h5 class="mt-4 mb-3">All Reviews</h5>
    <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
      <% listing.reviews.forEach(review => { %>
        <div class="card shadow-sm">
          <div class="card-body">
            <h6 class="text-primary mb-1">@<%= review.author.username %></h6>
            <p class="starability-result" data-rating="<%= review.rating %>"></p>
            <p class="mb-2"><%= review.comment %></p>

            <% if (currUser && String(review.author._id) === String(currUser._id)) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="text-muted">No reviews yet. Be the first to leave one!</p>
  <% } %>
</div>

        <div class="mt-5">
          <hr>
          <h3 class="text-center mb-3">Where you'll be</h3>
          <div class="d-flex justify-content-center">
            <div id="map"></div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>
