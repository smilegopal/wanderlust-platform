<% layout("/layouts/boilerplate") -%>
<body>
 <style>
#filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.filter {
text-align: center;
margin-right: 2rem;
margin-top: 2rem;
opacity: 0.7;
}
.filter:hover{
  opacity: 1;
  cursor: pointer;
}
.filter p{
  font-size: 0.8rem;
}
.tax-info{
  display: none;

}
.tax-toggles{
  border: 1px solid black;
  border-radius: 1rem;
  height: 3rem;
  padding: 1rem;
  margin-left: 36rem;
  display: flex;
  align-items: center;



}
.active-filter {
  opacity: 1 !important;
  font-weight: bold;
  border-bottom: 2px solid #000;
}


 </style>
 
   <div id="filters">
  <a  href="/listings?category=Trending"
   class="filter  <%= category === 'Trending' ? 'active-filter' : '' %>">
    
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>
   <a 
  href="/listings?category=Rooms" 
  class="filter <%= category === 'Rooms' ? 'active-filter' : '' %>"
>
   <div><i class="fa-solid fa-house"></i></div>
   <p>Rooms</p>
</a>

    <a href="/listings?category=Iconic cities"
     class="filter <%= category === 'Iconic Cities' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic cities</p>
  </a>

   <a href="/listings?category=Castles"
    class="filter <%= category === 'Castles' ? 'active-filter' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
    <a href="/listings?category=Restaurant"
     class="filter <%= category === 'Restaurant' ? 'active-filter' : '' %>">
    <div><i class="fa-solid fa-utensils"></i></div>
    <p>Restaurant</p>
  </a>

  <div class="tax-toggles">
  <div class="form-check-reverse form-switch">
   
  <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">display total after taxes</label>
  </div>
</div>

   </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of alllistings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
        <div class="card h-100 listing-card">
          <img 
            src="<%= listing.image.url %>" 
            class="card-img-top" 
            alt="listing_image" 
            style="height: 20rem; object-fit: cover;"
          />

          <div class="card-img-overlay text-white fw-bold">Guest Favorite</div>

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              <!-- ✅ Safe price handling -->
              &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
              <i class="tax-info">&nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>

</body>
<script>
  let taxSwitch=document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    let taxinfo=document.getElementsByClassName("tax-info");
    for(info of taxinfo){
      if(info.style.display!="inline"){
        info.style.display="inline";

      }else{
        info.style.display="none";
      }

    }
   
  })
</script>
