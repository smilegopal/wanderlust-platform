<% layout("/layouts/boilerplate") -%>
<body>

  <h3>All Listings</h3>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3">
    <% for (let listing of alllistings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
        <div class="card h-100">

          <% 
            // Handle both object {url} and string fallback
            var imgUrl = (listing.image && typeof listing.image === "object" && listing.image.url) 
              ? listing.image.url 
              : listing.image || "https://plus.unsplash.com/premium_photo-1683910767532-3a25b821f7ae?q=80&w=808&auto=format&fit=crop";
          %>

          <img 
            src="<%= imgUrl %>" 
            class="card-img-top" 
            alt="listing_image" 
            style="height: 20rem; object-fit: cover;"
          />

          <div class="card-img-overlay text-white fw-bold">Guest Favorite</div>

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>

</body>
