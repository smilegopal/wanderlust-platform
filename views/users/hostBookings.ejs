<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <h2>My Guests</h2>
  <hr>

  <% if (bookings.length === 0) { %>
      <p>No one has booked your listings yet.</p>
  <% } else { %>

      <% bookings.forEach(b => { %>
      <div class="card p-3 mb-3">

        <h5>Listing: <%= b.listing.title %></h5>

        <p>
          Guest:
          <b><%= b.user.username %></b>
          (<%= b.user.email %>)
        </p>

        <p>
          Booked On:
          <%= b.bookedAt ? b.bookedAt.toLocaleString() : "N/A" %>
        </p>

        <a href="/listings/<%= b.listing._id %>" class="btn btn-outline-primary btn-sm">
          View Listing
        </a>
      </div>
      <% }) %>

  <% } %>
</div>
